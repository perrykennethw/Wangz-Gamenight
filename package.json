{
  "name": "wangz-gamenight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "test:game-packs": "tsx server/feudGamePack.test.ts",
    "test:audio": "tsx server/gameAudio.test.ts",
    "test:spin-solve": "tsx server/spinSolve.test.ts",
    "test:privacy": "tsx server/privacy.integration.ts",
    "test:moderated-chat": "tsx server/moderatedChat.integration.ts",
    "test:presenter": "tsx server/presenter.test.ts",
    "server": "tsx server/index.ts",
    "start": "node server-dist/server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
