{
  "name": "wangz-gamenight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "verify": "node scripts/verify.mjs",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "test:game-packs": "tsx server/feudGamePack.test.ts",
    "test:avatars": "tsx server/avatarId.test.ts",
    "test:audio": "tsx server/gameAudio.test.ts",
    "test:timers": "tsx server/sharedTimer.test.ts",
    "test:spin-solve": "tsx server/spinSolve.test.ts",
    "test:fast-money": "tsx server/fastMoney.test.ts",
    "test:fast-money-focus": "tsx server/formFocus.test.ts",
    "test:fast-money-integration": "tsx server/fastMoney.integration.ts",
    "test:privacy": "tsx server/privacy.integration.ts",
    "test:room-replay": "tsx server/roomReplay.integration.ts",
    "test:moderated-chat": "tsx server/moderatedChat.integration.ts",
    "test:presenter": "tsx server/presenter.test.ts",
    "test:transient-status": "tsx server/transientStatus.test.ts",
    "test:room-invites": "tsx server/roomInvite.test.ts",
    "test:room-client": "tsx server/roomClient.test.ts",
    "test:room-notices": "tsx server/roomNotice.test.ts && vitest run server/roomNotice.ui.test.tsx --environment happy-dom",
    "test:feud-awards": "vitest run server/feudAward.ui.test.tsx --environment happy-dom",
    "test:team-chat": "vitest run server/teamChat.ui.test.tsx --environment happy-dom",
    "test:player-preferences": "tsx server/playerIdentityPreference.test.ts",
    "test:player-session": "tsx server/playerSessionIdentity.test.ts",
    "test:turn-order": "tsx server/feudTurnOrder.test.ts",
    "test:turn-order-integration": "tsx server/feudTurnOrder.integration.ts",
    "server": "tsx server/index.ts",
    "start": "node server-dist/server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.11.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
